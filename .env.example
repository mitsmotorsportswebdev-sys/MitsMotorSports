# PORT=5000 # optional; default 5000; integer 1-65535
# MONGODB_URI=<mongodb-atlas-connection-string-with-database-name> # required
# JWT_SECRET=<random-secret-at-least-32-characters> # required
# JWT_EXPIRES_IN=8h # optional; default 8h
# CLIENT_URL=http://localhost:5173 # required
# ADMIN_EMAIL=<admin-email> # required
# TRUST_PROXY=0 # optional; default 0
# EVENTS_RATE_LIMIT_WINDOW_MS=600000 # optional; default 600000
# EVENTS_RATE_LIMIT_MAX=10 # optional; default 10
# TEAM_RATE_LIMIT_WINDOW_MS=900000 # optional; default 900000
# TEAM_RATE_LIMIT_MAX=300 # optional; default 300
# REGISTRATION_RETENTION_DAYS=90 # optional; default 90
